# xqshare 服务端环境变量配置
# 复制此文件为 .env 并修改配置：cp .env.server.example .env

# ==================== 服务配置 ====================
XQSHARE_PORT=18812
LOG_LEVEL=INFO

# ==================== 行情配置 ====================
# token（默认）：xtdata 通过 xtdatacenter 直连迅投行情，不依赖 QMT
# qmt：保留旧行为，xtdata 连接已启动并登录的 QMT/MiniQMT
XQSHARE_MARKET_MODE=token

# 迅投投研用户中心的接口 Token；token 模式必填
XT_TOKEN=你的迅投接口TOKEN

# xtdatacenter 数据缓存目录；同一目录只能运行一个 xtdc 进程
XT_DATA_HOME=.xtdata-cache

# xtdatacenter 本地服务端口范围
XTDC_PORT_START=58620
XTDC_PORT_END=58650

# VIP K线全推，默认开启；默认初始化沪深市场
XT_KLINE_MIRROR=true
XT_INIT_MARKETS=SH,SZ
XT_KLINE_MIRROR_MARKETS=SH,SZ

# 可选：覆盖内置的官方 VIP 行情服务器池，使用逗号分隔
# XT_VIP_SERVERS=115.231.218.73:55310,115.231.218.79:55310,42.228.16.211:55300,42.228.16.210:55300,36.99.48.20:55300,36.99.48.21:55300

# ==================== QMT 交易配置（可选） ====================
# Token 仅替代行情连接；使用 XtQuantTrader 查询账户或交易时仍需启动 QMT。
# QMT_USERDATA_PATH=C:\QMT\userdata_mini
# QMT_ACCOUNT_ID=你的资金账号
